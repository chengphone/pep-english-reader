9d","english":"satellite","meaning":"人造卫星"},{"id":"e63-6a-002015-units-u5-e93d59a02163","english":"soil","meaning":"土壤"},{"id":"e63-6a-002015-units-u5-a49c1d038068","english":"alien","meaning":"外星生物"},{"id":"e63-6a-002015-units-u5-e9f2a0186210","english":"sunrise","meaning":"日出"},{"id":"e63-6a-002015-units-u5-b0c5f417a5a9","english":"rover","meaning":"探测器"},{"id":"e63-6a-002015-units-u5-6b847a0ed0b2","english":"into","meaning":"朝；进入"},{"id":"e63-6a-002015-units-u5-918d6b6a9b95","english":"telescope","meaning":"望远镜"},{"id":"e63-6a-002015-units-u5-df0c29d39619","english":"astronaut","meaning":"航天员；宇航员"},{"id":"e63-6a-002015-units-u5-c2c002ca28f6","english":"spaceship","meaning":"宇宙飞船"},{"id":"e63-6a-002015-units-u5-a5c7d1719e28","english":"month","meaning":"月；月份"},{"id":"e63-6a-002015-units-u5-35b7924ee4c6","english":"taikonaut","meaning":"中国航天员"},{"id":"e63-6a-002015-units-u5-d6e28ffb3b19","english":"cloth","meaning":"（一块）布；织物"},{"id":"e63-6a-002015-units-u5-26e466582de8","english":"toothpaste","meaning":"牙膏"},{"id":"e63-6a-002015-units-u5-1f5087db919c","english":"question","meaning":"问题"},{"id":"e63-6a-002015-units-u5-0829103205fb","english":"sunset","meaning":"日落"},{"id":"e63-6a-002015-units-u5-336074805fc8","english":"time","meaning":"次；回"},{"id":"e63-6a-002015-units-u5-a0a6ca091c70","english":"Mars","meaning":"火星"}]},{"id":"e63-6a-002015-units-u6","book":"六年级英语上册 · PEP新版（E63 002015）","title":"Unit 6","category":"units","source":"https://dd.e63.cn/reader.html?book=tape6a_002015","words":[{"id":"e63-6a-002015-units-u6-07d715edb696","english":"power","meaning":"能；能量"},{"id":"e63-6a-002015-units-u6-ae80c184961f","english":"electricity","meaning":"电"},{"id":"e63-6a-002015-units-u6-2bfbc118abca","english":"solar","meaning":"太阳的"},{"id":"e63-6a-002015-units-u6-1303c06b0b01","english":"type","meaning":"类型；种类"},{"id":"e63-6a-002015-units-u6-381cfb6e1e42","english":"energy","meaning":"能源"},{"id":"e63-6a-002015-units-u6-99a7026172d4","english":"light","meaning":"照亮"},{"id":"e63-6a-002015-units-u6-5a2a0ed9aa3a","english":"heat","meaning":"加热；（使）变暖；热量"},{"id":"e63-6a-002015-units-u6-c34045c1a1db","english":"cool","meaning":"（使）变凉, 冷却"},{"id":"e63-6a-002015-units-u6-acba25512100","english":"run","meaning":"（使）运转"},{"id":"e63-6a-002015-units-u6-5de95319f174","english":"resource","meaning":"资源"},{"id":"e63-6a-002015-units-u6-878edf659ebf","english":"run out","meaning":"用完"},{"id":"e63-6a-002015-units-u6-12ea12eace7d","english":"change","meaning":"（使）不同；改变"},{"id":"e63-6a-002015-units-u6-22c72aa82ce7","english":"quick","meaning":"迅速的；快的"},{"id":"e63-6a-002015-units-u6-528159b45697","english":"shower","meaning":"淋浴"},{"id":"e63-6a-002015-units-u6-5004da7363b8","english":"unplug","meaning":"拔掉⋯⋯的电源插头"},{"id":"e63-6a-002015-units-u6-69ea741e98fd","english":"difference","meaning":"差别；不同（之处）"},{"id":"e63-6a-002015-units-u6-4c7e98bfa0c7","english":"reduce","meaning":"减少"},{"id":"e63-6a-002015-units-u6-b690326d377b","english":"air conditioner","meaning":"空调机"},{"id":"e63-6a-002015-units-u6-7062520c5a0e","english":"drive","meaning":"驾驶；开车"},{"id":"e63-6a-002015-units-u6-d9c0d34144c1","english":"reuse","meaning":"再次使用；重复使用"},{"id":"e63-6a-002015-units-u6-5b3975651c3c","english":"own","meaning":"自己的"},{"id":"e63-6a-002015-units-u6-e4d693d24e64","english":"market","meaning":"集市；市场"},{"id":"e63-6a-002015-units-u6-7def9c79e5be","english":"bottle","meaning":"瓶子"},{"id":"e63-6a-002015-units-u6-28720365c5e7","english":"top","meaning":"（位置、级别或程度）最高的"},{"id":"e63-6a-002015-units-u6-a62ed7b95a2f","english":"useful","meaning":"有用的；有益的"},{"id":"e63-6a-002015-units-u6-d0c92c764c56","english":"dirty","meaning":"脏的"},{"id":"e63-6a-002015-units-u6-ea7bf4bb7230","english":"side","meaning":"一面；一边"}]},{"id":"e63-6a-002015-expressions-u1","book":"六年级英语上册 · PEP新版（E63 002015）","title":"常用表达 · Unit 1","category":"expressions","source":"https://dd.e63.cn/reader.html?book=tape6a_002015","words":[{"id":"e63-6a-002015-expressions-u1-24c72404a112","english":"How was your weekend?","meaning":"你周末过得怎么样？"},{"id":"e63-6a-002015-expressions-u1-360d3a1203c5","english":"It was great! I climbed the Great Wall.","meaning":"非常棒！我去爬长城了。"},{"id":"e63-6a-002015-expressions-u1-b8ac24186935","english":"What did you do, Leo?","meaning":"你做什么了，利奥？"},{"id":"e63-6a-002015-expressions-u1-53f459d93aaa","english":"I visited the \"Gingerbread House\" last Saturday.","meaning":"我上个星期六去参观“姜饼屋”了。"},{"id":"e63-6a-002015-expressions-u1-73e88847b10f","english":"Where did you go over the summer holidays, Binbin?","meaning":"你暑假去哪儿了，斌斌？"},{"id":"e63-6a-002015-expressions-u1-43f561b26435","english":"I went to Xi'an with my family.","meaning":"我和家人去西安了。"},{"id":"e63-6a-002015-expressions-u1-346ea6b55174","english":"What did you do there?","meaning":"你们在那儿做了些什么？"},{"id":"e63-6a-002015-expressions-u1-77537ebc7f03","english":"We went to see the Terracotta Warriors.","meaning":"我们去看兵马俑了。"},{"id":"e63-6a-002015-expressions-u1-44a7342c1ab4","english":"What else did you do?","meaning":"你们还做什么了？"}]},{"id":"e63-6a-002015-expressions-u2","book":"六年级英语上册 · PEP新版（E63 002015）","title":"常用表达 · Unit 2","category":"expressions","source":"https://dd.e63.cn/reader.html?book=tape6a_002015","words":[{"id":"e63-6a-002015-expressions-u2-fcac65dc5c3e","english":"How was your Mid-Autumn Festival holiday, Binbin?","meaning":"你中秋假期过得怎么样，斌斌？"},{"id":"e63-6a-002015-expressions-u2-50bef05affb0","english":"It was great!","meaning":"非常棒！"},{"id":"e63-6a-002015-expressions-u2-c2b9ee1609ca","english":"Did you take a trip?","meaning":"你们去旅行了吗？"},{"id":"e63-6a-002015-expressions-u2-3d723e0f378f","english":"No, we didn't.","meaning":"不，我们没有。"},{"id":"e63-6a-002015-expressions-u2-ca302acf3892","english":"Did you eat mooncakes?","meaning":"你们吃月饼了吗？"},{"id":"e63-6a-002015-expressions-u2-5e280875a916","english":"Yes, we did.","meaning":"是的，我们吃了。"},{"id":"e63-6a-002015-expressions-u2-5b4c82b8e7d1","english":"My mother and I went to a marathon on Sunday.","meaning":"我和妈妈上周日去看了一场马拉松比赛。"},{"id":"e63-6a-002015-expressions-u2-fbdca49cc168","english":"What did you like about it?","meaning":"你喜欢它哪一点？"},{"id":"e63-6a-002015-expressions-u2-cb5cf4ce81d0","english":"I liked watching the runners.","meaning":"我喜欢看参赛者（跑步）。"},{"id":"e63-6a-002015-expressions-u2-9778e0f89c31","english":"What did you do last weekend?","meaning":"你上周末做什么了？"}]},{"id":"e63-6a-002015-expressions-u3","book":"六年级英语上册 · PEP新版（E63 002015）","title":"常用表达 · Unit 3","category":"expressions","source":"https://dd.e63.cn/reader.html?book=tape6a_002015","words":[{"id":"e63-6a-002015-expressions-u3-e073b9af924a","english":"How do you feel?","meaning":"你感觉怎么样？"},{"id":"e63-6a-002015-expressions-u3-cbddaf6bb432","english":"I feel ill. My head hurts and I have a runny nose.","meaning":"我感觉不舒服。我头痛还流鼻涕。"},{"id":"e63-6a-002015-expressions-u3-cf6345ade84d","english":"I'm sorry to hear that. Maybe you should see a doctor.","meaning":"对此我感到难过。也许你应该去看医生。"},{"id":"e63-6a-002015-expressions-u3-8c62abcbcee1","english":"How can we live a healthy life?","meaning":"我们怎样能过健康的生活？"},{"id":"e63-6a-002015-expressions-u3-19e8a250d4b4","english":"We need to eat healthy food. We should exercise too.","meaning":"我们需要吃健康的食物。我们还需要运动。"},{"id":"e63-6a-002015-expressions-u3-c804774a8949","english":"Have a healthy diet.","meaning":"（保持）健康的饮食。"},{"id":"e63-6a-002015-expressions-u3-005343d136de","english":"Don't stay up late.","meaning":"不要熬夜。"},{"id":"e63-6a-002015-expressions-u3-a9ff464fcb27","english":"Think about happy things.","meaning":"想开心的事情。"},{"id":"e63-6a-002015-expressions-u3-d1655264a896","english":"Join clubs and teams.","meaning":"加入俱乐部和团队。"}]},{"id":"e63-6a-002015-expressions-u4","book":"六年级英语上册 · PEP新版（E63 002015）","title":"常用表达 · Unit 4","category":"expressions","source":"https://dd.e63.cn/reader.html?book=tape6a_002015","words":[{"id":"e63-6a-002015-expressions-u4-a0fd3b43a329","english":"How are you going to spend it?","meaning":"你打算怎么花（这些钱）？"},{"id":"e63-6a-002015-expressions-u4-24d08389fd9f","english":"I'm going to buy a schoolbag.","meaning":"我打算买一个书包。"},{"id":"e63-6a-002015-expressions-u4-de34a719326d","english":"I also want to buy some animal books.","meaning":"我还想买一些动物类书籍。"},{"id":"e63-6a-002015-expressions-u4-6db78048d903","english":"What else are you going to buy?","meaning":"你还打算买什么？"},{"id":"e63-6a-002015-expressions-u4-edb19d434d08","english":"I'm going to buy a pair of sunglasses for Grandpa.","meaning":"我打算给爷爷买一副太阳镜。"},{"id":"e63-6a-002015-expressions-u4-9b4fbd50dd7c","english":"I also want to buy a microscope.","meaning":"我还想买一个显微镜。"}]},{"id":"e63-6a-002015-expressions-u5","book":"六年级英语上册 · PEP新版（E63 002015）","title":"常用表达 · Unit 5","category":"expressions","source":"https://dd.e63.cn/reader.html?book=tape6a_002015","words":[{"id":"e63-6a-002015-expressions-u5-5356e8f1839c","english":"What can you see in the sky?","meaning":"你能在天空中看到什么？"},{"id":"e63-6a-002015-expressions-u5-b27d33355257","english":"We can see the Sun and clouds.","meaning":"我们能看到太阳和云。"},{"id":"e63-6a-002015-expressions-u5-a64c98d09d85","english":"At night, we can see the Moon and the stars.","meaning":"在晚上，我们能看到月亮和星星。"},{"id":"e63-6a-002015-expressions-u5-57819446fa0d","english":"Is there any water on Mars?","meaning":"火星上有水吗？"},{"id":"e63-6a-002015-expressions-u5-3eebfd46ada7","english":"Yes, there is. There is soil too.","meaning":"是，有的。那里还有土壤。"},{"id":"e63-6a-002015-expressions-u5-571977d64f1b","english":"Are there any aliens?","meaning":"那儿有外星生物吗？"},{"id":"e63-6a-002015-expressions-u5-af4da975d9c3","english":"I don't think so. They say there aren't any living things.","meaning":"我不这样认为。据说那里没有生物。"},{"id":"e63-6a-002015-expressions-u5-6317a2442b44","english":"China put a rover on Mars.","meaning":"中国在火星上放置了探测器。"},{"id":"e63-6a-002015-expressions-u5-4ad03f30267d","english":"The taikonauts get up early in the morning.","meaning":"中国航天员很早就起床。"}]},{"id":"e63-6a-002015-expressions-u6","book":"六年级英语上册 · PEP新版（E63 002015）","title":"常用表达 · Unit 6","category":"expressions","source":"https://dd.e63.cn/reader.html?book=tape6a_002015","words":[{"id":"e63-6a-002015-expressions-u6-824d7722ff40","english":"What do you know about it?","meaning":"关于它你知道些什么？"},{"id":"e63-6a-002015-expressions-u6-3d55e0baaf65","english":"Running water can make electricity.","meaning":"流水可以发电。"},{"id":"e63-6a-002015-expressions-u6-39e4e0b2cc26","english":"What else do you want to know about water?","meaning":"关于水你还想了解些什么？"},{"id":"e63-6a-002015-expressions-u6-01e7004f8368","english":"Where does water come from?","meaning":"水从哪儿来？"},{"id":"e63-6a-002015-expressions-u6-fa929d758bf5","english":"Wind power, solar power and water power are types of green energy.","meaning":"风能、太阳能和水能是不同类型的绿色能源。"},{"id":"e63-6a-002015-expressions-u6-c2f44eeb8c42","english":"But many resources are running out.","meaning":"但是很多资源快要耗尽了。"},{"id":"e63-6a-002015-expressions-u6-7857f0fc0f82","english":"What should we do?","meaning":"我们该怎么办？"},{"id":"e63-6a-002015-expressions-u6-43aad8bdcd15","english":"How can we save energy?","meaning":"我们怎样才能节约能源？"},{"id":"e63-6a-002015-expressions-u6-b8f8220af8e4","english":"We can take quick showers.","meaning":"我们可以快速淋浴。"},{"id":"e63-6a-002015-expressions-u6-b8e4b8e7f53e","english":"We can also use LED lighting.","meaning":"我们还可以使用LED照明。"},{"id":"e63-6a-002015-expressions-u6-88c4ceb2fb86","english":"We should use air conditioners less.","meaning":"我们应该少用空调。"}]}]}
