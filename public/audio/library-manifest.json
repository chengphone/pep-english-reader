{"schemaVersion":1,"voice":"en-US-AriaNeural","items":[{"text":"Hello! I'm Mike Black.","file":"audio/library/25115df085b7b656554e594c03bd3032f0eb21fa767625fee7c4d9e34719dfb5.mp3"},{"text":"Hi! My name is Wu Binbin.","file":"audio/library/0812364cc4edb8e8f94e9c2d94f45286ad3765b623c7fa2d74f9a7ea9d6f1eeb.mp3"},{"text":"Nice to meet you.","file":"audio/library/5ccf0626a4f0f725636207a5ee983f8d670dacc50867baf0ec88dd2fdb7c8681.mp3"},{"text":"Nice to meet you too.","file":"audio/library/869b13ddee2824734b87c08fd4bd8a2172ae8ec83ecc708144f9e62f205c574d.mp3"},{"text":"Oh no!","file":"audio/library/ff0cb3c6fd993cc8d911b94e74ed67639a4c1a0ffb77db412b50851f25c8f81f.mp3"},{"text":"It's OK, Chen Jie.","file":"audio/library/2fe6d23d20d859c86733ba199ecf1d62049c72bfe28c640819fa0ec130c8c9b6.mp3"},{"text":"Hey, Sarah! We can share.","file":"audio/library/7498d21a5480f68ce98ed822ae41adec2329b43971660a230f7550faa283fe7c.mp3"},{"text":"Thanks, Sarah. / Thank you, Chen Jie.","file":"audio/library/775891e94e6375502dce9a5f6720545790f7bad1b3aaae94d37b8e26b99858c4.mp3"},{"text":"I am nice to my friends.","file":"audio/library/65e51d8345eb0ace1cc4c184eea112f1655f4d1ca20c786b18adb49beb7dc83c.mp3"},{"text":"This is my grandma.","file":"audio/library/502f69683b61088af8d6887102e835f39751d6e1b0744a98850908fd3a3499c4.mp3"},{"text":"Look! This is my family.","file":"audio/library/00ed84e81b653fad25486046eb4d51884c5cafb09497afb741662eb03341edc5.mp3"},{"text":"Is that your brother?","file":"audio/library/0281fc2910a0b1919cf9524be6a898f4a8c866e3910eb42d1a6800adfa744f14.mp3"},{"text":"Yes, it is.","file":"audio/library/9c1236dee4553c35fef5c68cb737f3af4161565184475d349bb7a029dc0b39a7.mp3"},{"text":"They love each other.","file":"audio/library/653d761baa7d6b536bf2958bc1652e960362bde0d9a7cbf8e7e6b833dc5b7010.mp3"},{"text":"Good morning, Mike!","file":"audio/library/bb25848fa6c5c616d7751f839220109b73b826de352b9af4be542a6a44c649f9.mp3"},{"text":"Good morning! Come in.","file":"audio/library/9ee510fd931651d842ec16ce2404bbafda5cb75989a0d4dac8db477755ac63b1.mp3"},{"text":"Do you have a pet?","file":"audio/library/24d3419e242c222ce9f73d5803664cb46c7519631faafc6151cc695f1c31f482.mp3"},{"text":"No, I don't.","file":"audio/library/18d8453ff13e4a7907914639fa22fb866dc2fa53c98a60b7626c4ef0e3a15d8b.mp3"},{"text":"Yes, I do. I have a cat.","file":"audio/library/1097a7ec07536e1c2444c6de0c9f2c44ab026ffa7bab8621f7553280e742404c.mp3"},{"text":"Let's go to the zoo!","file":"audio/library/2ed3ced7acfe91c6d201108029397d52f14607110c1e03c4a097d27f90e90589.mp3"},{"text":"Great!","file":"audio/library/13d31c488a9572e59a13ff1080e5b2cfccb83146aa4d7397801f26aef4eac77f.mp3"},{"text":"What's this?","file":"audio/library/60ec9bb98310b3ab76e573cd821f207611afdaab246355784db5e73438fc8c32.mp3"},{"text":"It's a fox.","file":"audio/library/18b70be7a2f9c14732ef4f40dad4a0474f27d181ae4e0ec92e3131d15a07358e.mp3"},{"text":"Miss White, what's that?","file":"audio/library/28e9f6c034d81468ae1b725ebbdb00c5c30729804fccdac8a2973d4aede29fe5.mp3"},{"text":"It's a red panda.","file":"audio/library/66bf5586a77060321b04cd2f1bed8d9a70a5c909f9352efabeac0a3dd804535c.mp3"},{"text":"Mike, do you like apples?","file":"audio/library/a080d9cb362dcf002d14d619c0b0594ef84dd6ff3baf5bfb709f13f80c5e0f9d.mp3"},{"text":"Yes, I do. And you?","file":"audio/library/e548afa4cb511e012c609354ae4141f79b8febeaed165e8d170705d2a58a37c7.mp3"},{"text":"Do you like the farm?","file":"audio/library/a0ee9be8ee7bf3730f804b95417c03df266aba30e3bf3a62b5ce5a11d374dab3.mp3"},{"text":"I like the fresh air.","file":"audio/library/c793a607b07688023b1e4bd82bbcc5cb8757bbb4d1cc2e05c9e23ba50d17e1f6.mp3"},{"text":"We can plant new trees.","file":"audio/library/2cba149dcfec3fda8a68fd124e7d07d362bd61be71e97f423d73aee0e8f76eb6.mp3"},{"text":"Plants can give us many things.","file":"audio/library/dedb8a35057a98c72eb3adf8db83e2c898a2766b16ffdae73e2425756b22357d.mp3"},{"text":"What colour is it?","file":"audio/library/c05cfb860f2a09c37c0c16f7e759b6bfd6be33ba94b38a12f8ff1bb1c5d3f861.mp3"},{"text":"It's orange.","file":"audio/library/37448a1269151545dbd990fa57381b7acf54448ed7f6c838a0b4cc0e1579821b.mp3"},{"text":"Red and blue make purple.","file":"audio/library/afc3deb121dd3d3a8cf6720f7dcb5f1b2dcfb059ea1e4822f14e8450983bf3f9.mp3"},{"text":"What colours do you like?","file":"audio/library/5ae532db079e5708271de3cf8027579c84c67d711f8a75194c24904ba173200b.mp3"},{"text":"I like red and pink.","file":"audio/library/bbd836040530f07b680ffaa8d943ab72f58afea8b9b4e4b53fa2f12df490d0db.mp3"},{"text":"Let's draw some purple and brown birds.","file":"audio/library/c983d3271ea13c1a531d51b778beb21671efb16a0afaad6887f531b992c9f6f7.mp3"},{"text":"Use again!","file":"audio/library/b4e998c47ab2586f5ec2cc97dc09db50f6669ab27608432f3611f5c6ced61494.mp3"},{"text":"Be careful!","file":"audio/library/00ebc8715188a91267b8fbea5c6b223dc26af7a1119baa3de2e5e04a1d65183d.mp3"},{"text":"How old are you?","file":"audio/library/07adf71fcd65adf9eb3729bc5c452c2df193525c03522087e20d80de5c2d2bc9.mp3"},{"text":"I'm five years old.","file":"audio/library/016defe9c3116d2a22d53134dc70f3750bbe04f5af26f6b0077a9f03c5742878.mp3"},{"text":"Me too.","file":"audio/library/97e87a1646d7a59d4c25c8b5a1217291c42ad01452f681a0b8962352d3b2461e.mp3"},{"text":"How many apples?","file":"audio/library/73413be7a5869ca59fefb8ae9595b4a458c82006ef996912989501473cc07086.mp3"},{"text":"Two.","file":"audio/library/82b355dfc227463385225b09625653f6a91b33db79d796063f4e2f47991fad6b.mp3"},{"text":"Great! Let's go to the shop!","file":"audio/library/2c6909742cbcebaa6fa741370230e0edcc33bbd04addea0dba53ad265146f029.mp3"},{"text":"That's ten yuan, please.","file":"audio/library/1873c87bbca05d6f9835915f9ae6df004fb8f8c3fc15b5cb872a48b5330decc7.mp3"},{"text":"Here you are.","file":"audio/library/37c716477dd8b5ce925eeff061f3bf714cb48fb551627c87c774fa97a2b01f78.mp3"},{"text":"It's seven o'clock. Hurry!","file":"audio/library/bf0a96f470491d4ecf2491ffc23abdb7289c5e675edc50ba550ba13b49cadad4.mp3"},{"text":"Happy birthday!","file":"audio/library/f7d321f5a89ccfc273399cf9971fa7df6b3b50b5db646f4fb4eee819b836e8df.mp3"},{"text":"Oh, one more cut for the dog.","file":"audio/library/627640a1dd2bf2e7fafb7c889148e7a7e0f21ec34a56a32d95b868405b14a369.mp3"},{"text":"name","file":"audio/library/7e0b0bf66e42418cce4264ff9240c28dcb2ef9f924f05f50d0aed2c8df3ca75e.mp3"},{"text":"nice","file":"audio/library/4ff1c9e48103799f22bfc326141b0ba479372af6e0e4f90c00d331dde367f9a5.mp3"},{"text":"ear","file":"audio/library/c80c13f896c4c88ed0e1521ba7af1c4e5870b6af6332b182848a53a31a1c19cf.mp3"},{"text":"hand","file":"audio/library/f98be9565a7c5e13f0169ffd8f6b5ac9d8e33775a64078047e8a48bd84b3696b.mp3"},{"text":"eye","file":"audio/library/4e65ef26ddf4712c8acdec1416d602876702ff52b64e3c5690c7ad2620c23208.mp3"},{"text":"mouth","file":"audio/library/d479bf51f157fff6409d2a931e57940f0e82a259791a4956896ed929567879ae.mp3"},{"text":"arm","file":"audio/library/979b28ac67fd8a01e3d965f999ec33c76d37157043e0b26429a34e9f330b709b.mp3"},{"text":"can","file":"audio/library/b711d8858273b013a15701af141c5c02e454fbca8c0b5b92ff1c35ecf3a8577e.mp3"},{"text":"share","file":"audio/library/f324546c5884555153216443f5aaf6c12fec3716e22093080a36173465f940bf.mp3"},{"text":"smile","file":"audio/library/9378f18f909340d54faa5f99dfe9c915f5ce7f57450dba117efc747b91248b6f.mp3"},{"text":"listen","file":"audio/library/923383a531c26ec1b1a263feed24490c53af388735b51adfe56fb46523c2eb98.mp3"},{"text":"help","file":"audio/library/952c8ebc28706d9dc6f46c77e05d0d679c4e620376c17579b25009f12837f9fa.mp3"},{"text":"say","file":"audio/library/8bb935ad5d6e6fcd83260cef191eb84b356723e1ece7bc40b3eb495813d5d659.mp3"},{"text":"friend","file":"audio/library/be1a779137151576332318c9930fb9d5c31b008f0e2fd933fe92d89ad5c12cb2.mp3"},{"text":"good","file":"audio/library/5cb20881a271f67147d1e4414c722625909c95db8a13089b92e520967a36eaac.mp3"},{"text":"mum","file":"audio/library/507151a5c2036c4ca3b9b3fda3f5e3f83af1132e8bfa8757ad7a81b33e3d2889.mp3"},{"text":"dad","file":"audio/library/39e52b9